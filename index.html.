        function updateSetData(exIdx, setIdx, field, val) {
            if (!activeWorkout) return;
            if (field === 'reps' && typeof val === 'string' && isNaN(Number(val))) {
                activeWorkout.exercises[exIdx].sets[setIdx][field] = val;
            } else {
                activeWorkout.exercises[exIdx].sets[setIdx][field] = parseFloat(val) || val;
            }
            saveToStorage();
        }

        function toggleSetComplete(exIdx, setIdx) {
            if (!activeWorkout) return;
            const set = activeWorkout.exercises[exIdx].sets[setIdx];
            set.completed = !set.completed;
            saveToStorage();

            if (set.completed) {
                const restSeconds = activeWorkout.exercises[exIdx].rest || 90;
                if (restSeconds > 0) startRestTimer(restSeconds);
            }
            renderActiveWorkout();
        }

        function addSetToActiveExercise(exIdx) {
            if (!activeWorkout) return;
            const lastSet = activeWorkout.exercises[exIdx].sets[activeWorkout.exercises[exIdx].sets.length - 1];
            activeWorkout.exercises[exIdx].sets.push({
                weight: lastSet ? lastSet.weight : 0,
                reps: lastSet ? lastSet.reps : 10,
                completed: false
            });
            saveToStorage();
            renderActiveWorkout();
        }

        function removeSetFromActiveExercise(exIdx, setIdx) {
            if (!activeWorkout) return;
            activeWorkout.exercises[exIdx].sets.splice(setIdx, 1);
            saveToStorage();
            renderActiveWorkout();
        }

        function startRestTimer(seconds) {
            if (restTimer.interval) clearInterval(restTimer.interval);
            restTimer.totalSeconds = seconds;
            restTimer.remainingSeconds = seconds;

            const widget = document.getElementById('rest-timer-widget');
            const headerBtn = document.getElementById('header-timer-indicator');
            widget.classList.remove('hidden');
            headerBtn.classList.remove('hidden');

            updateRestTimerDisplay();

            restTimer.interval = setInterval(() => {
                restTimer.remainingSeconds--;
                updateRestTimerDisplay();

                if (restTimer.remainingSeconds <= 0) {
                    clearInterval(restTimer.interval);
                    playBeepSound();
                    stopRestTimer();
                }
            }, 1000);
        }

        function updateRestTimerDisplay() {
            const m = Math.floor(restTimer.remainingSeconds / 60);
            const s = restTimer.remainingSeconds % 60;
            const text = `${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;

            document.getElementById('rest-timer-display').innerText = text;
            document.getElementById('header-timer-text').innerText = text;
        }

        function adjustRestTime(delta) {
            restTimer.remainingSeconds = Math.max(0, restTimer.remainingSeconds + delta);
            updateRestTimerDisplay();
        }

        function stopRestTimer() {
            if (restTimer.interval) clearInterval(restTimer.interval);
            document.getElementById('rest-timer-widget').classList.add('hidden');
            document.getElementById('header-timer-indicator').classList.add('hidden');
        }

        function openTimerWidget() {
            document.getElementById('rest-timer-widget').classList.remove('hidden');
        }

        function playBeepSound() {
            try {
                const ctx = new (window.AudioContext || window.webkitAudioContext)();
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(880, ctx.currentTime);
                gain.gain.setValueAtTime(0.1, ctx.currentTime);
                osc.connect(gain);
                gain.connect(ctx.destination);
                osc.start();
                osc.stop(ctx.currentTime + 0.5);
            } catch (e) {
                console.log("Audio play suppressed or unsupported");
            }
        }

