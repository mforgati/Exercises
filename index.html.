<!DOCTYPE html>
<html lang="pt-BR" class="h-full bg-slate-950 text-slate-100">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>GymProgress - Planilha 30 Dias Hipertrofia & Condicionamento</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#fdf4ff',
                            100: '#f3e8ff',
                            500: '#c084fc',
                            600: '#a855f7',
                            700: '#9333ea',
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #0f172a;
        }
        ::-webkit-scrollbar-thumb {
            background: #334155;
            border-radius: 3px;
        }
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
    </style>
</head>
<body class="h-full flex flex-col font-sans overflow-hidden">

    <!-- App Container -->
    <div class="flex flex-col h-full max-w-md mx-auto w-full bg-slate-950 shadow-2xl relative border-x border-slate-900">
        
        <!-- Header Principal -->
        <header class="bg-slate-900 border-b border-slate-800 px-4 py-3 flex items-center justify-between z-10 shrink-0">
            <div class="flex items-center gap-2">
                <div class="w-8 h-8 rounded-lg bg-brand-500 flex items-center justify-center text-slate-950 font-extrabold text-xl">
                    G
                </div>
                <div>
                    <h1 class="text-md font-bold tracking-tight text-white flex items-center gap-1.5">
                        Gym<span class="text-brand-500">Progress</span>
                    </h1>
                    <p class="text-[9px] text-brand-100/70 font-semibold tracking-wider">Hipertrofia & Condicionamento 30D</p>
                </div>
            </div>
            
            <div class="flex items-center gap-2">
                <!-- Indicador de Status do Cronômetro Ativo -->
                <button id="header-timer-indicator" onclick="openTimerWidget()" class="hidden bg-slate-800 hover:bg-slate-700 text-brand-500 px-2.5 py-1 rounded-full text-xs font-semibold flex items-center gap-1.5 transition-all animate-pulse">
                    <i data-lucide="timer" class="w-3.5 h-3.5"></i>
                    <span id="header-timer-text">00:00</span>
                </button>
            </div>
        </header>

        <!-- Content Container -->
        <main class="flex-1 overflow-y-auto px-4 py-4 pb-24 space-y-4 relative">
            
            <!-- ABA 1: TREINAR (ACTIVE WORKOUT) -->
            <section id="tab-train" class="space-y-4 tab-content">
                
                <!-- CONCEITOS FUNDAMENTAIS ACCORDION -->
                <div class="bg-slate-900/90 border border-slate-800 rounded-2xl overflow-hidden shadow-lg">
                    <button onclick="toggleConcepts()" class="w-full px-4 py-3 flex items-center justify-between text-left hover:bg-slate-850/50 transition-all">
                        <div class="flex items-center gap-2">
                            <i data-lucide="book-open" class="w-4 h-4 text-brand-500"></i>
                            <span class="text-xs font-bold text-white uppercase tracking-wider">Diretrizes (30 Dias Hipertrofia)</span>
                        </div>
                        <i id="concepts-chevron" data-lucide="chevron-down" class="w-4 h-4 text-slate-400 transition-transform duration-300"></i>
                    </button>
                    
                    <div id="concepts-content" class="hidden px-4 pb-4 space-y-3 text-xs text-slate-300 border-t border-slate-800/40 pt-3">
                        <div class="p-2.5 bg-slate-950/60 rounded-xl border border-slate-850">
                            <h4 class="font-bold text-brand-500 flex items-center gap-1 mb-1">
                                <i data-lucide="target" class="w-3.5 h-3.5"></i> Diretrizes RPE & RIR
                            </h4>
                            <p class="leading-relaxed text-[11px] text-slate-400">
                                <strong>Semana 1:</strong> RIR 4-5 (Adaptação técnica). <strong>Semanas 2-3:</strong> RIR 2-3 (Hipertrofia padrão). Falha técnica (RIR 0-1) apenas na última série dos isoladores e em semanas de intensificação.
                            </p>
                        </div>
                        
                        <div class="p-2.5 bg-slate-950/60 rounded-xl border border-slate-850">
                            <h4 class="font-bold text-brand-500 flex items-center gap-1 mb-1">
                                <i data-lucide="clock" class="w-3.5 h-3.5"></i> Tempos de Descanso
                            </h4>
                            <ul class="list-disc pl-4 space-y-0.5 text-[11px] text-slate-400">
                                <li><strong>Compostos:</strong> 90s-120s (Recuperação neural completa)</li>
                                <li><strong>Isoladores:</strong> 45s-60s (Saturação metabólica local)</li>
                                <li><strong>Abdômen/Core:</strong> 45s (Estabilidade e densidade)</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- BANNER SESSÃO DE ALONGAMENTO PÓS-CARDIO -->
                <div class="bg-gradient-to-r from-emerald-950/70 via-slate-900 to-slate-900 border border-emerald-500/30 rounded-2xl p-3.5 flex items-center justify-between shadow-lg">
                    <div class="flex items-center gap-3">
                        <div class="w-9 h-9 rounded-xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0">
                            <i data-lucide="sparkles" class="w-5 h-5"></i>
                        </div>
                        <div>
                            <h4 class="text-xs font-bold text-white">Alongamento Pós-Cardio</h4>
                            <p class="text-[10px] text-slate-400">11 exercícios avançados & protocolos FNP ⚡</p>
                        </div>
                    </div>
                    <button onclick="openStretchingModal()" class="py-1.5 px-3 bg-emerald-500 hover:bg-emerald-400 active:scale-[0.98] text-slate-950 text-xs font-bold rounded-xl transition-all flex items-center gap-1 shadow-md shadow-emerald-500/10">
                        <i data-lucide="play" class="w-3.5 h-3.5 fill-current"></i> Iniciar
                    </button>
                </div>

                <!-- PLANNER WIDGET: 4 WEEKS PROGRAM -->
                <div id="program-planner-widget" class="bg-gradient-to-r from-slate-900 via-slate-900 to-slate-950 border border-brand-500/30 rounded-2xl p-4 space-y-3 shadow-xl">
                    <div class="flex items-center justify-between">
                        <div>
                            <div class="flex items-center gap-1.5">
                                <span class="w-2 h-2 rounded-full bg-brand-500 animate-pulse"></span>
                                <span class="text-[10px] text-brand-500 font-bold uppercase tracking-widest">Plano de 30 Dias Ativo</span>
                            </div>
                            <h3 class="text-sm font-bold text-white mt-0.5">Hipertrofia & Condicionamento</h3>
                        </div>
                        <div class="text-right">
                            <span class="text-[10px] text-slate-400 block">Duração: 4 Semanas</span>
                        </div>
                    </div>

                    <!-- Progress Bar -->
                    <div class="space-y-1">
                        <div class="flex justify-between text-[11px] text-slate-400">
                            <span>Progresso Geral do Ciclo</span>
                            <span id="program-overall-percentage" class="font-bold text-brand-500">0%</span>
                        </div>
                        <div class="w-full h-2 bg-slate-800 rounded-full overflow-hidden">
                            <div id="program-overall-bar" class="h-full bg-brand-500 transition-all duration-500" style="width: 0%"></div>
                        </div>
                    </div>

                    <!-- Week Selector & Guidance -->
                    <div class="bg-slate-950/60 p-2.5 rounded-xl border border-slate-800 space-y-2">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-semibold text-slate-300">Semana do Ciclo:</span>
                            <select id="program-week-select" onchange="changeActiveProgramWeek(this.value)" class="bg-slate-900 border border-slate-850 rounded px-2 py-1 text-xs text-brand-500 font-bold focus:outline-none">
                                <option value="1">Semana 1 - Adaptação (RIR 4-5)</option>
                                <option value="2">Semana 2 - Aumento Carga/Vol (+5%)</option>
                                <option value="3">Semana 3 - Intensificação (RIR 1-2)</option>
                                <option value="4">Semana 4 - Deload Ativo (-20%)</option>
                            </select>
                        </div>

                        <!-- Microcycle dynamic hint text -->
                        <div id="microcycle-guidance-box" class="p-2 bg-brand-500/10 border border-brand-500/20 rounded-lg text-[11px] text-brand-100">
                            <!-- Populated dynamically -->
                        </div>

                        <!-- Days of selected week checklist -->
                        <div id="program-days-checklist" class="grid grid-cols-5 gap-1 pt-1">
                            <!-- Populated by JS -->
                        </div>
                    </div>
                </div>

                <!-- Seção Inicial (Sem Treino Ativo) -->
                <div id="no-active-workout" class="space-y-4">
                    <div class="bg-gradient-to-br from-slate-900 to-slate-800 p-5 rounded-2xl border border-slate-800 text-center space-y-4">
                        <div class="w-12 h-12 bg-brand-500/10 text-brand-500 rounded-full flex items-center justify-center mx-auto">
                            <i data-lucide="dumbbell" class="w-6 h-6"></i>
                        </div>
                        <div class="space-y-1">
                            <h3 class="text-lg font-bold">Nenhum treino em andamento</h3>
                            <p class="text-xs text-slate-400">Selecione um dia no ciclo de 30 dias acima ou inicie uma ficha abaixo.</p>
                        </div>
                        <button onclick="startQuickWorkout()" class="w-full py-3 px-4 bg-brand-500 hover:bg-brand-600 active:scale-[0.98] transition-all text-slate-950 font-bold rounded-xl flex items-center justify-center gap-2 text-sm shadow-lg shadow-brand-500/20">
                            <i data-lucide="play" class="w-4 h-4 fill-current"></i> Iniciar Treino Avulso
                        </button>
                    </div>

                    <!-- Lista de Rotinas/Fichas Salvas para Iniciar -->
                    <div class="space-y-3">
                        <div class="flex items-center justify-between">
                            <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-400">Fichas de Treino da Semana</h2>
                            <button onclick="switchTab('templates')" class="text-xs text-brand-500 font-semibold hover:underline">Ver todas</button>
                        </div>
                        <div id="quick-start-templates-list" class="grid grid-cols-1 gap-2.5">
                            <!-- Inserido via JS -->
                        </div>
                    </div>
                </div>

                <!-- Seção Ativa (Treino em Progresso) -->
                <div id="active-workout-section" class="hidden space-y-4">
                    <!-- Painel de Status do Treino -->
                    <div class="bg-slate-900 rounded-2xl border border-slate-800 p-4 space-y-3 shadow-lg">
                        <div class="flex items-start justify-between">
                            <div>
                                <h2 id="active-workout-title" class="text-sm font-bold text-white">Treino A - Inferiores A</h2>
                                <p class="text-xs text-slate-400 flex items-center gap-1.5 mt-0.5">
                                    <i data-lucide="calendar" class="w-3.5 h-3.5"></i> <span id="active-workout-date">Hoje</span>
                                </p>
                            </div>
                            <div class="flex flex-col items-end">
                                <span id="active-workout-timer" class="text-xl font-mono font-bold text-brand-500">00:00:00</span>
                                <span class="text-[9px] text-slate-400 uppercase tracking-wider">tempo total</span>
                            </div>
                        </div>

                        <!-- Botões de Ação do Treino Ativo -->
                        <div class="grid grid-cols-2 gap-2 pt-2 border-t border-slate-800/80">
                            <button onclick="openAddExerciseToActiveModal()" class="py-2 px-3 bg-slate-800 hover:bg-slate-700 active:scale-[0.98] transition-all text-slate-200 text-xs font-semibold rounded-lg flex items-center justify-center gap-1.5">
                                <i data-lucide="plus" class="w-4 h-4"></i> Add Exercício
                            </button>
                            <button onclick="confirmFinishWorkout()" class="py-2 px-3 bg-brand-500 hover:bg-brand-600 active:scale-[0.98] transition-all text-slate-950 text-xs font-bold rounded-lg flex items-center justify-center gap-1.5 shadow-md shadow-brand-500/10">
                                <i data-lucide="check" class="w-4 h-4"></i> Finalizar Treino
                            </button>
                        </div>
                        
                        <button onclick="openStretchingModal()" class="w-full py-2 px-3 bg-emerald-950/60 hover:bg-emerald-900/60 border border-emerald-500/30 text-emerald-300 text-xs font-bold rounded-xl flex items-center justify-center gap-2 transition-all">
                            <i data-lucide="sparkles" class="w-4 h-4 text-emerald-400"></i> Sessão de Alongamento Pós-Cardio (Volta à Calma)
                        </button>

                        <button onclick="cancelActiveWorkout()" class="w-full text-center text-xs text-red-400 font-medium hover:underline pt-1">
                            Cancelar treino e descartar
                        </button>
                    </div>

                    <!-- Lista de Exercícios Atuais com Suas Séries -->
                    <div id="active-workout-exercises" class="space-y-4">
                        <!-- Gerado dinamicamente -->
                    </div>
                </div>
            </section>

            <!-- ABA 2: FICHAS DE TREINO (TEMPLATES) -->
            <section id="tab-templates" class="space-y-4 tab-content hidden">
                <div class="flex items-center justify-between">
                    <div>
                        <h2 class="text-lg font-bold">Suas Fichas</h2>
                        <p class="text-xs text-slate-400">Monte e gerencie suas rotinas de treino.</p>
                    </div>
                    <button onclick="openCreateTemplateModal()" class="p-2 bg-brand-500 hover:bg-brand-600 active:scale-[0.98] text-slate-950 font-bold rounded-xl flex items-center gap-1.5 text-xs transition-all shadow-md shadow-brand-500/15">
                        <i data-lucide="plus" class="w-4 h-4"></i> Nova Ficha
                    </button>
                </div>

                <!-- Lista de Fichas -->
                <div id="templates-list-container" class="space-y-3">
                    <!-- Inserido dinamicamente -->
                </div>
            </section>

            <!-- ABA 3: HISTÓRICO DE TREINOS -->
            <section id="tab-history" class="space-y-4 tab-content hidden">
                <div>
                    <h2 class="text-lg font-bold">Histórico</h2>
                    <p class="text-xs text-slate-400">Registro de consistência e cargas acumuladas.</p>
                </div>

                <!-- Lista de Sessões Passadas -->
                <div id="history-list-container" class="space-y-3">
                    <!-- Inserido dinamicamente -->
                </div>
            </section>

            <!-- ABA 4: EVOLUÇÃO (CHARTS) -->
            <section id="tab-progress" class="space-y-4 tab-content hidden">
                <div>
                    <h2 class="text-lg font-bold">Evolução</h2>
                    <p class="text-xs text-slate-400">Sua progressão de cargas máximas por exercício.</p>
                </div>

                <!-- Seletor de Exercício para Gráfico -->
                <div class="bg-slate-900 rounded-2xl border border-slate-800 p-4 space-y-4">
                    <div class="space-y-1.5">
                        <label for="progress-exercise-select" class="text-xs font-semibold text-slate-400 uppercase tracking-wider block">Escolha o Exercício</label>
                        <select id="progress-exercise-select" onchange="renderProgressChart()" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2.5 text-sm text-slate-200 focus:outline-none focus:border-brand-500 transition-all">
                            <!-- Inserido dinamicamente -->
                        </select>
                    </div>

                    <!-- Canvas do ChartJS -->
                    <div class="relative w-full h-64 bg-slate-950/40 rounded-xl p-2 border border-slate-800/40">
                        <canvas id="progressChart"></canvas>
                        <div id="empty-chart-state" class="hidden absolute inset-0 flex flex-col items-center justify-center p-4 text-center bg-slate-950/90 rounded-xl">
                            <i data-lucide="bar-chart-2" class="w-10 h-10 text-slate-600 mb-2"></i>
                            <p class="text-sm font-semibold text-slate-400">Sem dados suficientes para este exercício</p>
                            <p class="text-xs text-slate-500 mt-1">Registre este exercício em seus treinos concluídos para alimentar o gráfico.</p>
                        </div>
                    </div>
                </div>

                <!-- Estatísticas Rápidas -->
                <div class="grid grid-cols-2 gap-3">
                    <div class="bg-slate-900 p-3.5 rounded-xl border border-slate-800 flex items-center gap-3">
                        <div class="w-9 h-9 bg-brand-500/10 text-brand-500 rounded-lg flex items-center justify-center shrink-0">
                            <i data-lucide="award" class="w-5 h-5"></i>
                        </div>
                        <div>
                            <span class="text-[10px] text-slate-400 uppercase tracking-wider block">Total Treinos</span>
                            <span id="stats-total-workouts" class="text-base font-bold text-white">0</span>
                        </div>
                    </div>
                    <div class="bg-slate-900 p-3.5 rounded-xl border border-slate-800 flex items-center gap-3">
                        <div class="w-9 h-9 bg-brand-500/10 text-brand-500 rounded-lg flex items-center justify-center shrink-0">
                            <i data-lucide="zap" class="w-5 h-5"></i>
                        </div>
                        <div>
                            <span class="text-[10px] text-slate-400 uppercase tracking-wider block">Carga Total</span>
                            <span id="stats-total-volume" class="text-base font-bold text-white">0 kg</span>
                        </div>
                    </div>
                </div>
            </section>

            <!-- ABA 5: BIBLIOTECA DE EXERCÍCIOS -->
            <section id="tab-library" class="space-y-4 tab-content hidden">
                <div class="flex items-center justify-between">
                    <div>
                        <h2 class="text-lg font-bold">Biblioteca</h2>
                        <p class="text-xs text-slate-400">Explore e gerencie exercícios recomendados.</p>
                    </div>
                    <button onclick="openAddExerciseModal()" class="p-2 bg-slate-900 hover:bg-slate-800 border border-slate-800 active:scale-[0.98] text-brand-500 rounded-xl flex items-center gap-1.5 text-xs transition-all">
                        <i data-lucide="plus" class="w-4 h-4"></i> Criar Exercício
                    </button>
                </div>

                <!-- Filtro de Busca e Grupo Muscular -->
                <div class="space-y-2">
                    <div class="relative">
                        <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2"></i>
                        <input type="text" id="exercise-search-input" oninput="filterLibrary()" placeholder="Buscar exercício..." class="w-full bg-slate-900 border border-slate-800 rounded-xl pl-9 pr-4 py-2 text-sm text-slate-200 focus:outline-none focus:border-brand-500 transition-all">
                    </div>
                    <div class="flex gap-1 overflow-x-auto no-scrollbar py-1">
                        <button onclick="filterCategory('Todos')" class="exercise-cat-btn px-3 py-1 rounded-full text-xs font-semibold bg-brand-500 text-slate-950 transition-all shrink-0">Todos</button>
                        <button onclick="filterCategory('Pernas')" class="exercise-cat-btn px-3 py-1 rounded-full text-xs font-semibold bg-slate-900 text-slate-400 hover:bg-slate-800 transition-all shrink-0">Pernas</button>
                        <button onclick="filterCategory('Glúteos')" class="exercise-cat-btn px-3 py-1 rounded-full text-xs font-semibold bg-slate-900 text-slate-400 hover:bg-slate-800 transition-all shrink-0">Glúteos</button>
                        <button onclick="filterCategory('Peito')" class="exercise-cat-btn px-3 py-1 rounded-full text-xs font-semibold bg-slate-900 text-slate-400 hover:bg-slate-800 transition-all shrink-0">Peito</button>
                        <button onclick="filterCategory('Costas')" class="exercise-cat-btn px-3 py-1 rounded-full text-xs font-semibold bg-slate-900 text-slate-400 hover:bg-slate-800 transition-all shrink-0">Costas</button>
                        <button onclick="filterCategory('Ombros')" class="exercise-cat-btn px-3 py-1 rounded-full text-xs font-semibold bg-slate-900 text-slate-400 hover:bg-slate-800 transition-all shrink-0">Ombros</button>
                        <button onclick="filterCategory('Braços')" class="exercise-cat-btn px-3 py-1 rounded-full text-xs font-semibold bg-slate-900 text-slate-400 hover:bg-slate-800 transition-all shrink-0">Braços</button>
                        <button onclick="filterCategory('Core')" class="exercise-cat-btn px-3 py-1 rounded-full text-xs font-semibold bg-slate-900 text-slate-400 hover:bg-slate-800 transition-all shrink-0">Core</button>
                        <button onclick="filterCategory('Cardio')" class="exercise-cat-btn px-3 py-1 rounded-full text-xs font-semibold bg-slate-900 text-slate-400 hover:bg-slate-800 transition-all shrink-0">Cardio</button>
                        <button onclick="filterCategory('Alongamento')" class="exercise-cat-btn px-3 py-1 rounded-full text-xs font-semibold bg-slate-900 text-slate-400 hover:bg-slate-800 transition-all shrink-0">Alongamento</button>
                    </div>
                </div>

                <!-- Lista de Exercícios -->
                <div id="library-list-container" class="grid grid-cols-1 gap-2">
                    <!-- Inserido dinamicamente -->
                </div>
            </section>

        </main>

        <!-- Widget Cronômetro de Descanso Fixo/Flutuante no Rodapé -->
        <div id="rest-timer-widget" class="hidden absolute bottom-20 left-4 right-4 bg-slate-900 border border-slate-800 rounded-2xl p-4 shadow-2xl z-40 flex items-center justify-between gap-4 transition-all duration-300">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-brand-500/10 text-brand-500 flex items-center justify-center animate-pulse">
                    <i data-lucide="hourglass" class="w-5 h-5"></i>
                </div>
                <div>
                    <h4 class="text-xs font-bold text-white uppercase tracking-wide">Descanso sugerido</h4>
                    <span id="rest-timer-display" class="text-xl font-mono font-extrabold text-brand-500">01:30</span>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <button onclick="adjustRestTime(-15)" class="w-8 h-8 rounded-lg bg-slate-800 hover:bg-slate-700 text-white flex items-center justify-center font-bold text-sm">-15s</button>
                <button onclick="adjustRestTime(15)" class="w-8 h-8 rounded-lg bg-slate-800 hover:bg-slate-700 text-white flex items-center justify-center font-bold text-sm">+15s</button>
                <button onclick="stopRestTimer()" class="w-8 h-8 rounded-lg bg-red-500/10 hover:bg-red-500/20 text-red-400 flex items-center justify-center font-bold">
                    <i data-lucide="square" class="w-4 h-4 fill-current"></i>
                </button>
            </div>
        </div>

        <!-- Barra de Navegação Inferior -->
        <nav class="bg-slate-900/95 backdrop-blur-md border-t border-slate-800/80 fixed md:absolute bottom-0 left-0 right-0 max-w-md mx-auto z-30 flex items-center justify-around py-3 px-2">
            <button onclick="switchTab('train')" id="nav-btn-train" class="nav-btn flex flex-col items-center gap-1 py-1 text-brand-500">
                <i data-lucide="dumbbell" class="w-5 h-5"></i>
                <span class="text-[10px] font-semibold tracking-wider">Treinar</span>
            </button>
            <button onclick="switchTab('templates')" id="nav-btn-templates" class="nav-btn flex flex-col items-center gap-1 py-1 text-slate-400 hover:text-slate-200">
