        }

        function addExerciseToActiveWorkout(exId) {
            const exObj = exercises.find(e => e.id === exId);
            if (!exObj || !activeWorkout) return;

            const isCardio = exObj.category === 'Cardio' || exObj.name.toLowerCase().includes('cardio') || exObj.name.toLowerCase().includes('liss') || exObj.name.toLowerCase().includes('hiit');

            activeWorkout.exercises.push({
                exerciseId: exObj.id,
                name: exObj.name,
                category: exObj.category,
                tip: exObj.tip,
                alt: exObj.alt,
                rest: exObj.rest,
                sets: isCardio ? [
                    { weight: 20, reps: 'Mod', completed: false }
                ] : [
                    { weight: 0, reps: 10, completed: false },
                    { weight: 0, reps: 10, completed: false }
                ]
            });

            saveToStorage();
            closeModal();
            renderActiveWorkout();
        }

        function confirmFinishWorkout() {
            const backdrop = document.getElementById('modal-backdrop');
            const modal = document.getElementById('modal-confirm-finish');
            
            Array.from(backdrop.children).forEach(child => child.classList.add('hidden'));
            
            backdrop.classList.remove('hidden');
            backdrop.classList.add('flex');
            modal.classList.remove('hidden');
        }

        function finishWorkout() {
            if (!activeWorkout) return;

            const durMins = Math.floor(activeWorkout.elapsedSeconds / 60);
            const durSecs = activeWorkout.elapsedSeconds % 60;
            const durationStr = `${durMins.toString().padStart(2, '0')}:${durSecs.toString().padStart(2, '0')}`;

            const session = {
                id: activeWorkout.id,
                name: activeWorkout.name,
                date: activeWorkout.date,
                duration: durationStr,
                exercises: activeWorkout.exercises
            };

            if (activeWorkout.programKey) {
                completedProgramDays[activeWorkout.programKey] = true;
            }

            history.unshift(session);
            activeWorkout = null;
            if (workoutTimer.interval) clearInterval(workoutTimer.interval);

            saveToStorage();
            closeModal();
            switchTab('history');
            showCustomAlert("Parabéns!", "Treino concluído e registrado no seu histórico!", true);
        }

        function cancelActiveWorkout() {
            activeWorkout = null;
            if (workoutTimer.interval) clearInterval(workoutTimer.interval);
            saveToStorage();
            renderActiveWorkout();
            showCustomAlert("Cancelado", "O treino em andamento foi descartado.", false);
        }

        function renderQuickStartTemplates() {
            const container = document.getElementById('quick-start-templates-list');
            if (!container) return;
            container.innerHTML = '';

            templates.forEach(t => {
                const card = document.createElement('div');
                card.className = "bg-slate-900 border border-slate-800 rounded-xl p-3 flex items-center justify-between hover:border-slate-700 transition-all";
                card.innerHTML = `
                    <div>
                        <h4 class="text-xs font-bold text-white">${t.name}</h4>
                        <p class="text-[10px] text-slate-400 mt-0.5">${t.exerciseIds.length} exercícios</p>
                    </div>
                    <button onclick="startWorkoutFromTemplate('${t.id}')" class="py-1.5 px-3 bg-brand-500/10 hover:bg-brand-500 text-brand-500 hover:text-slate-950 text-xs font-bold rounded-lg border border-brand-500/20 transition-all flex items-center gap-1">
                        <i data-lucide="play" class="w-3.5 h-3.5 fill-current"></i> Iniciar
                    </button>
                `;
                container.appendChild(card);
            });
            lucide.createIcons();
        }

        function renderTemplatesTab() {
            const container = document.getElementById('templates-list-container');
            if (!container) return;
            container.innerHTML = '';

            templates.forEach(t => {
                const card = document.createElement('div');
                card.className = "bg-slate-900 border border-slate-800 rounded-2xl p-4 space-y-3 shadow-lg";

                let exNames = t.exerciseIds.map(id => {
                    const ex = exercises.find(e => e.id === id);
                    return ex ? ex.name : null;
                }).filter(Boolean).join(', ');

                card.innerHTML = `
                    <div class="flex items-start justify-between">
                        <div>
                            <h3 class="text-sm font-bold text-white">${t.name}</h3>
                            <p class="text-xs text-slate-400 mt-1 line-clamp-2">${exNames || 'Sem exercícios'}</p>
                        </div>
                        <div class="flex items-center gap-1">
                            <button onclick="editTemplate('${t.id}')" class="p-1.5 text-slate-400 hover:text-white">
                                <i data-lucide="edit-3" class="w-4 h-4"></i>
                            </button>
                            <button onclick="deleteTemplate('${t.id}')" class="p-1.5 text-slate-400 hover:text-red-400">
                                <i data-lucide="trash-2" class="w-4 h-4"></i>
                            </button>
                        </div>
                    </div>
                    <button onclick="startWorkoutFromTemplate('${t.id}')" class="w-full py-2 bg-brand-500 hover:bg-brand-600 text-slate-950 text-xs font-bold rounded-xl flex items-center justify-center gap-1.5 transition-all">
                        <i data-lucide="play" class="w-3.5 h-3.5 fill-current"></i> Iniciar Este Treino
                    </button>
                `;
                container.appendChild(card);
            });
            lucide.createIcons();
        }

        function openCreateTemplateModal(templateId = null) {
            const container = document.getElementById('template-exercise-selection-list');
            if (!container) return;
            container.innerHTML = '';

            let existing = null;
            if (templateId) {
                existing = templates.find(t => t.id === templateId);
            }

            document.getElementById('template-modal-title').innerText = existing ? 'Editar Ficha' : 'Criar Nova Ficha';
            document.getElementById('template-name').value = existing ? existing.name : '';

            exercises.forEach(ex => {
                const isChecked = existing ? existing.exerciseIds.includes(ex.id) : false;
                const item = document.createElement('label');
                item.className = "flex items-center justify-between p-2 rounded-xl bg-slate-950/60 hover:bg-slate-800 border border-slate-850 cursor-pointer text-xs";
                item.innerHTML = `
                    <div class="flex items-center gap-2">
                        <input type="checkbox" value="${ex.id}" ${isChecked ? 'checked' : ''} class="template-ex-checkbox w-4 h-4 rounded border-slate-700 text-brand-500 focus:ring-brand-500 bg-slate-900">
                        <span class="font-semibold text-slate-200">${ex.name}</span>
                    </div>
                    <span class="text-[9px] text-brand-500 font-bold uppercase">${ex.category}</span>
                `;
                container.appendChild(item);
            });

            const saveBtn = document.getElementById('save-template-btn');
            saveBtn.onclick = () => saveTemplate(templateId);

            const backdrop = document.getElementById('modal-backdrop');
            const modal = document.getElementById('modal-create-template');

            Array.from(backdrop.children).forEach(child => child.classList.add('hidden'));
            backdrop.classList.remove('hidden');
            backdrop.classList.add('flex');
            modal.classList.remove('hidden');
        }

        function saveTemplate(existingId = null) {
            const name = document.getElementById('template-name').value.trim();
            if (!name) {
                showCustomAlert("Aviso", "Informe o nome da ficha.", false);
                return;
            }

            const checked = Array.from(document.querySelectorAll('.template-ex-checkbox:checked')).map(cb => cb.value);

            if (checked.length === 0) {
                showCustomAlert("Aviso", "Selecione ao menos 1 exercício.", false);
                return;
            }

            if (existingId) {
                const idx = templates.findIndex(t => t.id === existingId);
                if (idx !== -1) {
                    templates[idx].name = name;
                    templates[idx].exerciseIds = checked;
                }
            } else {
                templates.push({
                    id: 't-' + Date.now(),
                    name,
                    exerciseIds: checked
                });
            }

            saveToStorage();
            closeModal();
            renderTemplatesTab();
            showCustomAlert("Salvo", "Ficha de treino atualizada com sucesso!", true);
        }

        function editTemplate(id) {
            openCreateTemplateModal(id);
        }

        function deleteTemplate(id) {
            templates = templates.filter(t => t.id !== id);
            saveToStorage();
            renderTemplatesTab();
            showCustomAlert("Excluído", "Ficha removida com sucesso.", false);
        }

        function renderHistoryTab() {
            const container = document.getElementById('history-list-container');
            if (!container) return;
            container.innerHTML = '';

            if (history.length === 0) {
                container.innerHTML = `
                    <div class="p-8 text-center text-slate-500 bg-slate-900/50 rounded-2xl border border-slate-850 space-y-2">
                        <i data-lucide="history" class="w-10 h-10 mx-auto opacity-40"></i>
                        <p class="text-xs font-semibold">Nenhum treino concluído ainda.</p>
                        <p class="text-[10px]">Complete uma sessão de treino para visualizá-la aqui.</p>
                    </div>
                `;
                lucide.createIcons();
                return;
            }

            history.forEach((session, idx) => {
                const dateObj = new Date(session.date);
                const formattedDate = dateObj.toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' });

                let totalVolume = 0;
                if (session.exercises) {
                    session.exercises.forEach(e => {
                        e.sets.forEach(s => {
                            if (s.completed && typeof s.weight === 'number') totalVolume += (s.weight || 0) * (s.reps || 0);
                        });
                    });
                }

                const card = document.createElement('div');
                card.className = "bg-slate-900 border border-slate-800 rounded-2xl p-4 space-y-2 hover:border-slate-700 transition-all cursor-pointer";
                card.onclick = () => viewHistoryDetail(idx);

                card.innerHTML = `
                    <div class="flex items-center justify-between">
                        <h4 class="text-xs font-bold text-white">${session.name}</h4>
                        <span class="text-[10px] text-slate-400 font-mono">${formattedDate}</span>
                    </div>
                    <div class="flex items-center gap-4 text-[11px] text-slate-400 pt-1 border-t border-slate-850">
                        <span class="flex items-center gap-1"><i data-lucide="clock" class="w-3 h-3 text-brand-500"></i> ${session.duration || '00:00'}</span>
                        <span class="flex items-center gap-1"><i data-lucide="zap" class="w-3 h-3 text-brand-500"></i> ${totalVolume} kg</span>
                        <span class="flex items-center gap-1"><i data-lucide="dumbbell" class="w-3 h-3 text-brand-500"></i> ${session.exercises ? session.exercises.length : 0} ex.</span>
                    </div>
                `;
                container.appendChild(card);
            });
            lucide.createIcons();
        }

        function viewHistoryDetail(index) {
            const session = history[index];
            if (!session) return;

            document.getElementById('history-detail-title').innerText = session.name;
            const dateObj = new Date(session.date);
            document.getElementById('history-detail-date').innerText = dateObj.toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' });
            document.getElementById('history-detail-duration').innerText = session.duration || '00:00';

            let totalVolume = 0;
            const exContainer = document.getElementById('history-detail-exercises');
            exContainer.innerHTML = '';

            if (session.exercises) {
                session.exercises.forEach(ex => {
                    let setsDetail = '';
                    ex.sets.forEach((s, sIdx) => {
                        if (s.completed && typeof s.weight === 'number') totalVolume += (s.weight || 0) * (s.reps || 0);
                        setsDetail += `<span class="inline-block bg-slate-900 px-2 py-0.5 rounded text-[10px] text-slate-300 border border-slate-800 mr-1 mb-1">S${sIdx+1}: ${s.weight || 0} x ${s.reps || 0}</span>`;
                    });

                    const block = document.createElement('div');
                    block.className = "bg-slate-950/60 p-2.5 rounded-xl border border-slate-850 space-y-1";
                    block.innerHTML = `
                        <h5 class="text-xs font-bold text-white">${ex.name}</h5>
                        <div>${setsDetail || '<span class="text-[10px] text-slate-500">Sem séries concluídas</span>'}</div>
                    `;
                    exContainer.appendChild(block);
                });
            }

            document.getElementById('history-detail-volume').innerText = `${totalVolume} kg`;

            const delBtn = document.getElementById('delete-history-btn');
            delBtn.onclick = () => deleteHistoryItem(index);

            const backdrop = document.getElementById('modal-backdrop');
            const modal = document.getElementById('modal-history-detail');

            Array.from(backdrop.children).forEach(child => child.classList.add('hidden'));
            backdrop.classList.remove('hidden');
            backdrop.classList.add('flex');
            modal.classList.remove('hidden');
            lucide.createIcons();
        }

        function deleteHistoryItem(index) {
            history.splice(index, 1);
            saveToStorage();
            closeModal();
            renderHistoryTab();
            showCustomAlert("Removido", "Registro excluído com sucesso do seu histórico.", false);
        }

        let chartInstance = null;

        function initProgressTab() {
            const select = document.getElementById('progress-exercise-select');
            if (!select) return;
            select.innerHTML = '';

            exercises.forEach(ex => {
                const opt = document.createElement('option');
                opt.value = ex.id;
                opt.innerText = `${ex.name} (${ex.category})`;
                select.appendChild(opt);
            });

            // Stats
            document.getElementById('stats-total-workouts').innerText = history.length;
            let grandVolume = 0;
            history.forEach(session => {
                if (session.exercises) {
                    session.exercises.forEach(e => {
                        e.sets.forEach(s => {
                            if (s.completed && typeof s.weight === 'number') grandVolume += (s.weight || 0) * (s.reps || 0);
                        });
                    });
                }
            });
            document.getElementById('stats-total-volume').innerText = `${grandVolume.toLocaleString('pt-BR')} kg`;

            renderProgressChart();
        }

        function renderProgressChart() {
            const select = document.getElementById('progress-exercise-select');
            if (!select || !select.value) return;
            const exId = select.value;

            const points = [];
            const labels = [];
            const sortedHistory = [...history].reverse();

            sortedHistory.forEach(session => {
                if (session.exercises) {
                    const exData = session.exercises.find(e => e.exerciseId === exId);
                    if (exData) {
                        let maxWeight = 0;
                        exData.sets.forEach(s => {
                            if (s.completed && typeof s.weight === 'number' && s.weight > maxWeight) {
                                maxWeight = s.weight;
                            }
                        });
                        if (maxWeight > 0) {
                            const dateObj = new Date(session.date);
                            labels.push(dateObj.toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit' }));
                            points.push(maxWeight);
                        }
                    }
                }
            });

            const emptyState = document.getElementById('empty-chart-state');
            const canvas = document.getElementById('progressChart');

            if (points.length === 0) {
                emptyState.classList.remove('hidden');
                if (chartInstance) {
                    chartInstance.destroy();
                    chartInstance = null;
                }
                return;
            } else {
                emptyState.classList.add('hidden');
            }

            if (chartInstance) chartInstance.destroy();

            const ctx = canvas.getContext('2d');
            chartInstance = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Carga Máxima (kg)',
                        data: points,
                        borderColor: '#c084fc',
                        backgroundColor: 'rgba(192, 132, 252, 0.1)',
                        fill: true,
                        tension: 0.3,
                        pointBackgroundColor: '#c084fc',
                        pointRadius: 5
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        x: {
                            grid: { color: 'rgba(51, 65, 85, 0.3)' },
                            ticks: { color: '#94a3b8', font: { size: 10 } }
                        },
                        y: {
                            grid: { color: 'rgba(51, 65, 85, 0.3)' },
                            ticks: { color: '#94a3b8', font: { size: 10 } }
                        }
                    }
                }
            });
        }

        let currentLibCategory = 'Todos';

        function renderLibraryTab() {
            filterLibrary();
        }

        function filterCategory(cat) {
            currentLibCategory = cat;
            document.querySelectorAll('.exercise-cat-btn').forEach(btn => {
                if (btn.innerText === cat) {
                    btn.className = "exercise-cat-btn px-3 py-1 rounded-full text-xs font-semibold bg-brand-500 text-slate-950 transition-all shrink-0";
                } else {
                    btn.className = "exercise-cat-btn px-3 py-1 rounded-full text-xs font-semibold bg-slate-900 text-slate-400 hover:bg-slate-800 transition-all shrink-0";
                }
            });
            filterLibrary();
        }

        function filterLibrary() {
            const searchInput = document.getElementById('exercise-search-input');
            const search = searchInput ? searchInput.value.toLowerCase() : '';
            const container = document.getElementById('library-list-container');
            if (!container) return;
            container.innerHTML = '';

            let filtered = exercises;
            if (currentLibCategory !== 'Todos') {
                filtered = filtered.filter(e => e.category === currentLibCategory);
            }

            if (search) {
                filtered = filtered.filter(e => e.name.toLowerCase().includes(search) || e.category.toLowerCase().includes(search));
            }

            filtered.forEach(ex => {
                const card = document.createElement('div');
                card.className = "bg-slate-900 border border-slate-800 rounded-xl p-3 space-y-1 hover:border-slate-700 transition-all";
                card.innerHTML = `
                    <div class="flex items-center justify-between">
                        <h4 class="text-xs font-bold text-white">${ex.name}</h4>
                        <span class="text-[9px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-brand-500/10 text-brand-500 border border-brand-500/20">${ex.category}</span>
                    </div>
                    ${ex.tip ? `<p class="text-[10px] text-slate-400"><strong class="text-brand-500">Dica:</strong> ${ex.tip}</p>` : ''}
                    ${ex.alt ? `<p class="text-[10px] text-slate-400"><strong class="text-slate-500">Alt:</strong> ${ex.alt}</p>` : ''}
                `;
                container.appendChild(card);
            });
            lucide.createIcons();
        }

        function openAddExerciseModal() {
            const backdrop = document.getElementById('modal-backdrop');
            const modal = document.getElementById('modal-add-exercise');

            Array.from(backdrop.children).forEach(child => child.classList.add('hidden'));
            backdrop.classList.remove('hidden');
            backdrop.classList.add('flex');
            modal.classList.remove('hidden');
        }

        function saveNewExercise() {
            const name = document.getElementById('new-ex-name').value.trim();
            const category = document.getElementById('new-ex-category').value;
            const tip = document.getElementById('new-ex-tip').value.trim();
            const alt = document.getElementById('new-ex-alternative').value.trim();
            const rest = parseInt(document.getElementById('new-ex-rest').value) || 90;

            if (!name) {
                showCustomAlert("Aviso", "Por favor, informe o nome do exercício.", false);
                return;
            }

            const newEx = {
                id: 'ex-' + Date.now(),
                name,
                category,
                tip,
                alt,
                rest
            };

            exercises.push(newEx);
            saveToStorage();
            closeModal();
            filterLibrary();
            showCustomAlert("Sucesso", "Novo exercício cadastrado na biblioteca!", true);
        }

        function showCustomAlert(title, text, isSuccess) {
            document.getElementById('alert-title').innerText = title;
            document.getElementById('alert-text').innerText = text;

            const iconContainer = document.getElementById('alert-icon');
            if (isSuccess) {
                iconContainer.className = "w-10 h-10 rounded-full flex items-center justify-center mx-auto bg-emerald-500/10 text-emerald-400";
                iconContainer.innerHTML = `<i data-lucide="check-circle" class="w-5 h-5"></i>`;
            } else {
                iconContainer.className = "w-10 h-10 rounded-full flex items-center justify-center mx-auto bg-brand-500/10 text-brand-500";
                iconContainer.innerHTML = `<i data-lucide="info" class="w-5 h-5"></i>`;
            }

            const backdrop = document.getElementById('modal-backdrop');
            const modal = document.getElementById('modal-alert');

            Array.from(backdrop.children).forEach(child => child.classList.add('hidden'));

            backdrop.classList.remove('hidden');
            backdrop.classList.add('flex');
            modal.classList.remove('hidden');
            lucide.createIcons();
        }

        function closeModal() {
            const backdrop = document.getElementById('modal-backdrop');
            backdrop.classList.add('hidden');
            backdrop.classList.remove('flex');
            Array.from(backdrop.children).forEach(child => child.classList.add('hidden'));
        }

        window.onload = function() {
            lucide.createIcons();
            switchTab('train');
        };
    </script>
</body>
</html>
