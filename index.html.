        function startWorkoutFromTemplate(templateId, programKey = null) {
            const template = templates.find(t => t.id === templateId);
            if (!template) return;

            const workoutExercises = [];
            template.exerciseIds.forEach(exId => {
                const exObj = exercises.find(e => e.id === exId);
                if (exObj) {
                    const isCardio = exObj.category === 'Cardio' || exObj.name.toLowerCase().includes('cardio') || exObj.name.toLowerCase().includes('liss') || exObj.name.toLowerCase().includes('hiit');
                    workoutExercises.push({
                        exerciseId: exObj.id,
                        name: exObj.name,
                        category: exObj.category,
                        tip: exObj.tip,
                        alt: exObj.alt,
                        rest: exObj.rest,
                        sets: isCardio ? [
                            { weight: 20, reps: 'Mod', completed: false }
                        ] : [
                            { weight: 0, reps: 10, completed: false },
                            { weight: 0, reps: 10, completed: false },
                            { weight: 0, reps: 10, completed: false }
                        ]
                    });
                }
            });

            activeWorkout = {
                id: 'w-' + Date.now(),
                name: template.name,
                programKey: programKey,
                date: new Date().toISOString(),
                elapsedSeconds: 0,
                exercises: workoutExercises
            };

            saveToStorage();
            startWorkoutTimer();
            renderActiveWorkout();
        }

        function startWorkoutTimer() {
            if (workoutTimer.interval) clearInterval(workoutTimer.interval);
            workoutTimer.elapsedSeconds = activeWorkout ? activeWorkout.elapsedSeconds : 0;

            workoutTimer.interval = setInterval(() => {
                if (activeWorkout) {
                    workoutTimer.elapsedSeconds++;
                    activeWorkout.elapsedSeconds = workoutTimer.elapsedSeconds;
                    updateWorkoutTimerDisplay();
                }
            }, 1000);
        }

        function updateWorkoutTimerDisplay() {
            const display = document.getElementById('active-workout-timer');
            if (!display) return;
            const s = workoutTimer.elapsedSeconds;
            const hrs = Math.floor(s / 3600);
            const mins = Math.floor((s % 3600) / 60);
            const secs = s % 60;
            display.innerText = `${hrs.toString().padStart(2, '0')}:${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
        }

